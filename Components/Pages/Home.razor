@page "/"

@using CSE325_GROUP.Data
@using CSE325_GROUP.Models
@using CSE325_GROUP.Components.Account.Shared
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject IWebHostEnvironment Environment
@inject ILogger<Home> Logger

<PageTitle>Home | GameTracker</PageTitle>

<StatusMessage Message="@errorMessage" />

<section class="welcome-panel" aria-labelledby="welcome-heading">
    <div class="welcome-copy">
        <p class="page-eyebrow">Welcome to GameTracker</p>
        <h1 id="welcome-heading">A home for your games.</h1>
        <p class="welcome-description">Discover your next adventure and keep your gaming collection in one place.</p>
        <div class="page-actions">
            <a class="btn btn-primary" href="#featured-games">Explore games</a>
            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-outline-primary" href="profile">View my profile</a>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-primary" href="Account/Register">Create an account</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
    <div class="catalog-note">
        <span class="catalog-count">@gameCount</span>
        <span>games in the catalog</span>
        <p>From familiar favorites to a new adventure.</p>
    </div>
</section>

<section id="featured-games" class="featured-section" aria-labelledby="featured-heading">
    <div class="section-heading">
        <div>
            <p class="page-eyebrow">Discover</p>
            <h2 id="featured-heading">Featured games</h2>
        </div>
        <p>A few picks from our collection.</p>
    </div>

    @if (featuredGames.Count == 0)
    {
        <div class="page-empty-state">
            <h3>The collection is getting started.</h3>
            <p>Games will appear here once they have been added to the catalog.</p>
        </div>
    }
    else
    {
        <div class="game-grid">
            @foreach (var game in featuredGames)
            {
                var cover = GetCoverImage(game.CoverImage);
                <article class="game-card" @key="game.Id">
                    @if (cover is not null)
                    {
                        <a class="game-cover-link" href="/game/@game.Id">
                            <img class="game-cover" src="@cover" alt="Cover of @game.Title" loading="lazy" width="400" height="500" />
                        </a>
                    }
                    else
                    {
                        <div class="game-cover cover-placeholder">Cover unavailable</div>
                    }
                    <div class="game-card-body">
                        <div class="game-meta">
                            <span>@game.Genre</span>
                            @if (game.ReleaseYear is not null)
                            {
                                <span>@game.ReleaseYear</span>
                            }
                        </div>
                        <h3>@game.Title</h3>
                        <p>@game.Platform</p>
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private int gameCount;
    private List<Game> featuredGames = [];
    private string? errorMessage;
    private readonly Dictionary<string, string> coverImages = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            gameCount = await DbContext.Games.CountAsync();
            featuredGames = await DbContext.Games.AsNoTracking()
                .OrderBy(game => game.Id)
                .Take(6)
                .ToListAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the game catalog for the home page.");
            errorMessage = "The game catalog couldn't be loaded. Please try again later.";
            return;
        }

        // Seeded covers may use a different extension from the files in wwwroot.
        var coversDirectory = Path.Combine(Environment.WebRootPath, "images", "games");
        if (Directory.Exists(coversDirectory))
        {
            foreach (var file in Directory.EnumerateFiles(coversDirectory))
            {
                if (Path.GetExtension(file).ToLowerInvariant() is ".png" or ".jpg" or ".jpeg" or ".webp")
                {
                    coverImages.TryAdd(Path.GetFileNameWithoutExtension(file), $"/images/games/{Path.GetFileName(file)}");
                }
            }
        }
    }

    private string? GetCoverImage(string coverImage)
    {
        return coverImages.GetValueOrDefault(Path.GetFileNameWithoutExtension(coverImage));
    }
}
