@page "/"

@rendermode InteractiveServer

@using CSE325_GROUP.Data
@using CSE325_GROUP.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject IWebHostEnvironment Environment

<PageTitle>Home | GameTracker</PageTitle>

<section class="welcome-panel" aria-labelledby="welcome-heading">
    <div class="welcome-copy">
        <p class="page-eyebrow">Welcome to GameTracker</p>
        <h1 id="welcome-heading">A home for your games.</h1>
        <p class="welcome-description">Discover your next adventure and keep your gaming collection in one place.</p>
        <div class="page-actions">
            <a class="btn btn-primary" href="#featured-games">Explore games</a>
            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-outline-primary" href="profile">View my profile</a>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-primary" href="Account/Register">Create an account</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
    <div class="catalog-note">
        <span class="catalog-count">@games.Count</span>
        <span>games in the catalog</span>
        <p>From familiar favorites to a new adventure.</p>
    </div>
</section>

<section id="featured-games" class="featured-section" aria-labelledby="featured-heading">
    <div class="section-heading">
        <div>
            <p class="page-eyebrow">Discover</p>
            <h2 id="featured-heading">Browse games</h2>
        </div>
        <p>Find your next adventure in our collection.</p>
    </div>

    <div class="catalog-filters" role="search" aria-label="Search and filter games">
        <div class="filter-field">
            <label for="game-search">Search games</label>
            <input id="game-search" class="form-control" type="search" placeholder="Search by title..."
                   @bind="searchTerm" @bind:event="oninput" aria-controls="game-results" />
        </div>
        <div class="filter-field">
            <label for="game-genre">Genre</label>
            <select id="game-genre" class="form-select" @bind="selectedGenre" aria-controls="game-results">
                <option value="">All genres</option>
                @foreach (var genre in genres)
                {
                    <option value="@genre">@genre</option>
                }
            </select>
        </div>
        <div class="filter-field">
            <label for="game-platform">Platform</label>
            <select id="game-platform" class="form-select" @bind="selectedPlatform" aria-controls="game-results">
                <option value="">All platforms</option>
                @foreach (var platform in platforms)
                {
                    <option value="@platform">@platform</option>
                }
            </select>
        </div>
        <div class="filter-field">
            <label for="game-year">Release year</label>
            <select id="game-year" class="form-select" @bind="selectedReleaseYear" aria-controls="game-results">
                <option value="">All years</option>
                @foreach (var year in releaseYears)
                {
                    <option value="@year">@year</option>
                }
                @if (games.Any(game => game.ReleaseYear is null))
                {
                    <option value="unknown">Not announced</option>
                }
            </select>
        </div>
    </div>

    @{
        var filteredGames = GetFilteredGames();
    }
    <div class="results-summary">
        <p role="status" aria-live="polite" aria-atomic="true">Showing @filteredGames.Count of @games.Count games</p>
        <button class="btn btn-outline-primary" type="button" @onclick="ClearFilters" disabled="@(!HasActiveFilters)">
            Clear filters
        </button>
    </div>

    <div id="game-results">
        @if (games.Count == 0)
        {
            <div class="page-empty-state">
                <h3>The collection is getting started.</h3>
                <p>Games will appear here once they have been added to the catalog.</p>
            </div>
        }
        else if (filteredGames.Count == 0)
        {
            <div class="page-empty-state">
                <h3>No games match your search.</h3>
                <p>Try a different title or clear the filters to explore the full catalog.</p>
            </div>
        }
        else
        {
            <div class="game-grid">
                @foreach (var game in filteredGames)
                {
                    var cover = GetCoverImage(game.CoverImage);
                    <article class="game-card" @key="game.Id">
                        @if (cover is not null)
                        {
                            <a class="game-cover-link" href="/game/@game.Id">
                                <img class="game-cover" src="@cover" alt="Cover of @game.Title" loading="lazy" width="400" height="500" />
                            </a>
                        }
                        else
                        {
                            <div class="game-cover cover-placeholder">Cover unavailable</div>
                        }
                        <div class="game-card-body">
                            <div class="game-meta">
                                <span>@game.Genre</span>
                                @if (game.ReleaseYear is not null)
                                {
                                    <span>@game.ReleaseYear</span>
                                }
                            </div>
                            <h3>@game.Title</h3>
                            <p>@game.Platform</p>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<Game> games = [];
    private List<string> genres = [];
    private List<string> platforms = [];
    private List<int> releaseYears = [];
    private string searchTerm = string.Empty;
    private string selectedGenre = string.Empty;
    private string selectedPlatform = string.Empty;
    private string selectedReleaseYear = string.Empty;
    private readonly Dictionary<string, string> coverImages = new(StringComparer.OrdinalIgnoreCase);

    private bool HasActiveFilters => !string.IsNullOrEmpty(searchTerm)
        || !string.IsNullOrEmpty(selectedGenre)
        || !string.IsNullOrEmpty(selectedPlatform)
        || !string.IsNullOrEmpty(selectedReleaseYear);

    protected override async Task OnInitializedAsync()
    {
        games = await DbContext.Games.AsNoTracking()
            .OrderBy(game => game.Id)
            .ToListAsync();

        genres = games.Select(game => game.Genre.Trim())
            .Where(genre => !string.IsNullOrEmpty(genre))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(genre => genre)
            .ToList();
        platforms = games.SelectMany(game => GetPlatforms(game.Platform))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(platform => platform)
            .ToList();
        releaseYears = games.Where(game => game.ReleaseYear.HasValue)
            .Select(game => game.ReleaseYear!.Value)
            .Distinct()
            .OrderByDescending(year => year)
            .ToList();

        // Seeded covers may use a different extension from the files in wwwroot.
        var coversDirectory = Path.Combine(Environment.WebRootPath, "images", "games");
        if (Directory.Exists(coversDirectory))
        {
            foreach (var file in Directory.EnumerateFiles(coversDirectory))
            {
                if (Path.GetExtension(file).ToLowerInvariant() is ".png" or ".jpg" or ".jpeg" or ".webp")
                {
                    coverImages.TryAdd(Path.GetFileNameWithoutExtension(file), $"/images/games/{Path.GetFileName(file)}");
                }
            }
        }
    }

    private List<Game> GetFilteredGames()
    {
        var query = searchTerm.Trim();
        return games.Where(game =>
            (string.IsNullOrEmpty(query) || game.Title.Contains(query, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrEmpty(selectedGenre) || string.Equals(game.Genre.Trim(), selectedGenre, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrEmpty(selectedPlatform) || GetPlatforms(game.Platform).Contains(selectedPlatform, StringComparer.OrdinalIgnoreCase))
            && (string.IsNullOrEmpty(selectedReleaseYear) || (game.ReleaseYear?.ToString() ?? "unknown") == selectedReleaseYear))
            .ToList();
    }

    private static string[] GetPlatforms(string platform)
    {
        return platform.Split(';', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedGenre = string.Empty;
        selectedPlatform = string.Empty;
        selectedReleaseYear = string.Empty;
    }

    private string? GetCoverImage(string coverImage)
    {
        return coverImages.GetValueOrDefault(Path.GetFileNameWithoutExtension(coverImage));
    }
}
