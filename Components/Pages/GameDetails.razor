@page "/game"
@page "/game/{Id}"
@rendermode InteractiveServer

@using CSE325_GROUP.Data
@using CSE325_GROUP.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using System.Security.Claims
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<GameDetails> Logger
@inject NavigationManager NavigationManager

<PageTitle>Game Details</PageTitle>

<div class="container py-4">
    @if (isLoading)
    {
        <p role="status">Loading game details...</p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        <a class="btn btn-primary" href="/">Back to games</a>
    }
    else if (game is null)
    {
        <div class="alert alert-warning" role="alert">
            Game not found.
        </div>
        <a class="btn btn-primary" href="/">Back to games</a>
    }
    else
    {
        <a class="btn btn-outline-secondary mb-4" href="/">&larr; Back to games</a>

        <article class="row g-4 align-items-start">
            <div class="col-12 col-md-4 col-lg-3">
                <img class="img-fluid rounded shadow-sm w-100" src="@GetImagePath(game.CoverImage)" alt="Cover art for @game.Title" />
            </div>
            <div class="col-12 col-md-8 col-lg-9">
                <h1>@game.Title</h1>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="badge text-bg-secondary">@game.Genre</span>
                    @if (game.ReleaseYear is not null)
                    {
                        <span class="badge text-bg-secondary">@game.ReleaseYear</span>
                    }
                </div>

                <p class="lead">@game.Description</p>

                <dl class="row mt-4">
                    <dt class="col-sm-3">Platform</dt>
                    <dd class="col-sm-9">@game.Platform</dd>

                    <dt class="col-sm-3">Genre</dt>
                    <dd class="col-sm-9">@game.Genre</dd>

                    <dt class="col-sm-3">Release year</dt>
                    <dd class="col-sm-9">@(game.ReleaseYear?.ToString() ?? "Unknown")</dd>
                </dl>

                @if (isInCollection)
                {
                    <button class="btn btn-success" disabled>
                        Added to My Games
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="AddToMyGames">
                        Add to My Games
                    </button>
                }

                @if (!string.IsNullOrEmpty(message))
                {
                    <p class="mt-2">@message</p>
                }
            </div>
        </article>
    }
</div>

@code {
    [Parameter]
    public string? Id { get; set; }

    private Game? game;
    private bool isLoading = true;
    private bool isInCollection;
    private string message = string.Empty;
    private string? errorMessage;
    private string? userId;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        game = null;
        isInCollection = false;
        errorMessage = null;

        if (!int.TryParse(Id, out var gameId) || gameId <= 0)
        {
            NavigationManager.NotFound();
            isLoading = false;
            return;
        }

        try
        {
            game = await Db.Games
                .AsNoTracking()
                .SingleOrDefaultAsync(item => item.Id == gameId);

            if (game is null)
            {
                NavigationManager.NotFound();
                return;
            }

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (userId != null)
            {
                isInCollection = await Db.UserGames
                    .AnyAsync(ug => ug.UserId == userId && ug.GameId == gameId);
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load game details for game {GameId}.", gameId);
            errorMessage = "Game details couldn't be loaded. Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetImagePath(string imagePath)
    {
        return imagePath.EndsWith(".webp", StringComparison.OrdinalIgnoreCase)
            ? imagePath[..^5] + ".png"
            : imagePath;
    }

    // Add the game to the user's collection
    private async Task AddToMyGames()
    {
        if (userId == null || game == null)
        {
            message = "You must be logged in to add games.";
            return;
        }

        var userGame = new UserGame
        {
            UserId = userId,
            GameId = game.Id,
            Status = "Want to Play",
            Rating = null
        };

        try
        {
            Db.UserGames.Add(userGame);
            await Db.SaveChangesAsync();

            isInCollection = true;
            errorMessage = null;
            message = "Game added to My Games!";
        }
        catch (Exception exception)
        {
            Db.Entry(userGame).State = EntityState.Detached;
            Logger.LogError(exception, "Failed to add game {GameId} to the user's collection.", game.Id);
            errorMessage = "This game couldn't be added. Please try again.";
        }
    }
}
